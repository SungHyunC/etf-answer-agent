# ── 모델 백엔드 선택 ────────────────────────────────────────────────
# rule   : LLM 없이 규칙 기반으로 동작 (키 불필요, 기본값)
# openai : OpenAI API
# local  : 사내 폐쇄망 vLLM / Ollama 등 OpenAI 호환 엔드포인트  ← RFP 요구 구성
LLM_BACKEND=rule

# LLM_BACKEND=openai 일 때
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM_BACKEND=local 일 때 (예: Ollama)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b-instruct
LOCAL_API_KEY=not-needed
